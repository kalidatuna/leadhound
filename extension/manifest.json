{
  "manifest_version": 3,
  "name": "leadhound",
  "version": "0.5.0",
  "description": "Send the page you are on to leadhound: save it as a lead, or check the website for problems you can fix.",
  "action": { "default_popup": "popup.html", "default_title": "Send to leadhound" },
  "permissions": ["activeTab", "scripting", "storage"],
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "browser_specific_settings": { "gecko": { "id": "leadhound@kalidatuna.github.io", "strict_min_version": "115.0" } }
}
